# Install on the app server:   crontab -e   (as a user that can run docker)
# Database backup every night at 02:30 server time, restore proof on the 1st of each month.
30 2 * * *   BACKUP_REMOTE="" HEALTHCHECK_PING_URL="" /opt/justicelink/ops/backup-db.sh  >> /var/log/justicelink-backup.log 2>&1
15 4 1 * *   /opt/justicelink/ops/restore-test.sh >> /var/log/justicelink-restore-test.log 2>&1

# Install on a DIFFERENT machine:
# * * * * *  ALERT_WEBHOOK="https://example.invalid/hook" /opt/justicelink/ops/healthcheck.sh >> /var/log/justicelink-health.log 2>&1
