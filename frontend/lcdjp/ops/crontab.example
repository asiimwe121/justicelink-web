# /etc/cron.d/justicelink  (env vars live in /etc/justicelink/backup.env, mode 600)
30 1 * * *  root  set -a; . /etc/justicelink/backup.env; set +a; /opt/justicelink/ops/backup-mysql.sh >> /var/log/justicelink-backup.log 2>&1
0 4 1 * *   root  set -a; . /etc/justicelink/backup.env; set +a; HEALTHCHECK_URL="$RESTORE_HEALTHCHECK_URL" /opt/justicelink/ops/restore-test.sh >> /var/log/justicelink-restore-test.log 2>&1
