# Copy to .env and fill in. Never commit .env.
# --- required ---
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=support@justicelinkug.org
GOOGLE_MAPS_API_KEY=
GROQ_API_KEY=
# Optional backup AI provider (used only if Groq fails). Use a billing-enabled Google project, see notes.
GEMINI_API_KEY=
# Hugging Face is used for embeddings only (legal knowledge / RAG).
HUGGINGFACE_API_KEY=
# --- proxy / network ---
# 127.0.0.1 when nginx/Caddy runs on this host (recommended), otherwise 0.0.0.0 and firewall port 8080.
APP_BIND_ADDRESS=0.0.0.0
# Proxies in front of the app: 1 = one nginx, 2 = Cloudflare + nginx. 0 = legacy (client-forgeable headers).
TRUSTED_PROXY_HOPS=0
# --- sizing ---
APP_MEM_LIMIT=1g
APP_CPUS=2
MYSQL_MEM_LIMIT=1g
REDIS_MEM_LIMIT=384m
REDIS_MAXMEMORY=256mb
DB_POOL_MAX_SIZE=20
TOMCAT_MAX_THREADS=100
# --- backups ---
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# --- optional ---
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-3.5-flash-lite
# AI_PROVIDERS=groq,gemini
SUNBIRD_API_TOKEN=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
SYSTEM_ADMIN_INITIAL_PASSWORD=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
